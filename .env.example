# ── App / identidade na fábrica ──
APP_NAME=SaaS Template
SAAS_SLUG=saas-template
NODE_ENV=development
TRIAL_DAYS=7
# PAYWALL_PREFIXES=/dashboard,/app

# ── URLs ──
BETTER_AUTH_URL=http://localhost:3000
# openssl rand -base64 32
BETTER_AUTH_SECRET=troque-por-um-secret-longo-de-pelo-menos-32-chars

# ── Postgres (1 database por SaaS na VPS compartilhada) ──
DATABASE_URL=postgres://saas:saas@127.0.0.1:5435/saas_template

# ── Redis ──
REDIS_URL=redis://127.0.0.1:6380
REDIS_PREFIX=saas_template:

# ── Quack Checkout ──
QUACK_WEBHOOK_SECRET=
QUACK_PRODUCT_ID=
# Link estável do checkout (produto ou offer) — CTA paywall
QUACK_CHECKOUT_URL=
# Espelho client-side se o Lovable precisar no browser
NEXT_PUBLIC_QUACK_CHECKOUT_URL=

# ── Control plane (admin multi-SaaS) ──
# URL do saas-control
FACTORY_CONTROL_URL=http://localhost:3100
# Mesma key configurada no control como INGEST_KEYS
FACTORY_INGEST_KEY=dev-ingest-key-change-me
